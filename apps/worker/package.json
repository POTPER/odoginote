{
  "name": "@odoginote/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "pnpm --filter @odoginote/shared build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply odoginote-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply odoginote-db --remote"
  },
  "dependencies": {
    "@odoginote/shared": "workspace:*",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "wrangler": "^4.0.0",
    "typescript": "^5.8.2"
  }
}
